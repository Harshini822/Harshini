// 7. Create an object with a method and use call and apply to invoke it with a different context.

const student = {
    course: 'IT',
    personInfo(name,age){
      console.log(`Name : ${name} Age : ${age} , course: ${this.course}`);
    }
  };
  const personInfo = student.personInfo;
  const professor = {
    course: 'CSE',
  };
  
  personInfo.call(professor,'Mary Cooper',27);
  console.log(professor);
  personInfo.call(student,'Jeremy Gilbert',22);
  console.log(student);
  
  const details = ['John Doe', 25];
  personInfo.apply(professor,details);
  personInfo.call(student,...details);

